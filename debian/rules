#!/usr/bin/make -f

DEB_BUILD_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_BUILD_GNU_TYPE)
DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
DEB_CMAKE_BUILD_DIR := build-$(DEB_HOST_GNU_TYPE)

# Clang needs an explicit target triple for cross builds.
DEB_CMAKE_TARGET_FLAGS :=
ifneq ($(DEB_BUILD_GNU_TYPE),$(DEB_HOST_GNU_TYPE))
DEB_CMAKE_TARGET_FLAGS += -DCMAKE_CXX_COMPILER_TARGET=$(DEB_HOST_GNU_TYPE)
DEB_CMAKE_TARGET_FLAGS += -DCMAKE_SYSTEM_NAME=Linux
endif

%:
	dh $@ --buildsystem cmake+ninja --builddirectory=$(DEB_CMAKE_BUILD_DIR)

override_dh_auto_configure:
	dh_auto_configure -- \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_CXX_COMPILER=clang++ \
	-DCMAKE_CXX_FLAGS_RELEASE="-O3 -gdwarf-4" \
	-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
	$(DEB_CMAKE_TARGET_FLAGS)

execute_after_dh_auto_install:
	install -Dm644 LICENSE debian/kwin-screen-corners/usr/share/doc/kwin-screen-corners/copyright
