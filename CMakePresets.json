{
    "version": 6,
    "configurePresets": [
        {
            "name": "clang",
            "displayName": "Clang",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
            }
        }
    ]
}
